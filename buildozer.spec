[app]
title = Halo Kivy
package.name = halokivy
package.domain = org.ariefsue
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,kivy
orientation = portrait
fullscreen = 0
android.archs = arm64-v8a
